NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://contract:contract@localhost:5432/contract_db?schema=public

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=30d

UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:3000

# database (default) | local | s3
STORAGE_MODE=database

# Object storage (optional — only if STORAGE_MODE=s3 or credentials set)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# OAuth (optional, for future)
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=

# Free plan limits
FREE_ANALYSES_PER_MONTH=3

# GigaChat (https://developers.sber.ru/studio)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
